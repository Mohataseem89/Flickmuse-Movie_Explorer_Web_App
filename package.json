{
  "name": "flickmuse-movie-explorer",
  "private": true,
  "version": "1.0.0",
  "description": "A production-minded React movie discovery app powered by TMDb.",
  "author": "Mohataseem Khan",
  "homepage": "https://flickmuse.mohataseem.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohataseem89/Flickmuse-Movie_Explorer_Web_App.git"
  },
  "bugs": {
    "url": "https://github.com/Mohataseem89/Flickmuse-Movie_Explorer_Web_App/issues"
  },
  "keywords": [
    "react",
    "vite",
    "tailwind-css",
    "tmdb",
    "movie-discovery"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "npx vercel@latest dev",
    "build": "vite build && node scripts/generate-seo-pages.mjs",
    "lint": "eslint .",
    "test:utils": "node --test tests/*.test.js",
    "test:components": "vitest run",
    "test": "npm run test:utils && npm run test:components",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.55.1",
    "typescript": "5.9.2"
  }
}
