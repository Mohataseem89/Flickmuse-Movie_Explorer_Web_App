{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flickmuse-movie-explorer-web-app",
  "main": "worker.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}